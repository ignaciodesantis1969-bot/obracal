              <span className="text-[9px] font-bold text-slate-500 uppercase leading-tight">
                {tick.label1}
              </span>
              <span className="text-[10px] font-black text-slate-800 leading-tight">
                {tick.label2}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

                {compromisos.map((c, idx) => {
                  const resp = personal.find(p => String(p.id || p.ID) === String(c.responsable_id));
                  return (
                    <div
                      key={c.id || idx}
                      className={cn(
                        'flex items-start gap-2 p-2 rounded-lg border text-xs',

                          <td className="px-4 py-2 text-right text-amber-700 font-bold">$ {gg.real.toLocaleString('es-AR', { maximumFractionDigits: 0 })}</td>
                          <td className="px-4 py-2 text-right font-bold">
                            {renderDesvioConFlecha(gg.desvio)}
                          </td>

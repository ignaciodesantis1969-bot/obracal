      const descripcionFinal = `${descClean}\n---DATOS_SICE_INTEGRAL---\n${payloadDataJson}`;

      // 🔑 Resolver datos del responsable
      const respSeleccionado = responsablesDisponibles.find(u =>
        String(u.id) === String(formData.responsable_id)

                        <User className="w-3 h-3 text-slate-400" /> {item.encargado?.split('@')[0] || '---'}
                      </td>
                      <td className="px-6 py-4 text-sm text-slate-600">
                        {item.latitud && item.longitud ? (
                          <a 
                            href={`https://maps.google.com/?q=${item.latitud},${item.longitud}`}

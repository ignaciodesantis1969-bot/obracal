      <div className="pt-3 border-t border-slate-100">
        <p className="text-[10px] font-black text-slate-500 uppercase tracking-wider mb-2">
          Planes activos ({planesActivos.length})
        </p>
        {planesActivos.length === 0 ? (
          <EmptyState
            icon={Activity}
